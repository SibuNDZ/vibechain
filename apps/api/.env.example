# Database
DATABASE_URL=postgresql://vibechain:vibechain_dev@localhost:5432/vibechain

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=super-secret-jwt-key-change-in-production
AUTH_NONCE_TTL_MS=600000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Server
PORT=3001
NODE_ENV=development

# Solana RPC
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# Cloudinary (for video uploads)
CLOUDINARY_CLOUD_NAME=cloud-name
CLOUDINARY_API_KEY=cloudinary-api-key
CLOUDINARY_API_SECRET=cloudinary-api-secret

# OpenAI (for AI features - optional, AI features disabled if not set)
OPENAI_API_KEY=openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Admin Access (comma-separated user IDs)
ADMIN_USER_IDS=
