# Server Configuration
NODE_ENV=production
PORT=3001

# Database (use connection pooling like PgBouncer in production)
DATABASE_URL=postgresql://user:password@db-host:5432/vibechain?connection_limit=10

# Security
JWT_SECRET=256-bit-secret-key-here-use-openssl-rand-hex-32
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=https://vibechain.app

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Solana RPC Endpoint (use Alchemy, Helius, or QuickNode in production)
SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SOLANA_CLUSTER=mainnet-beta

# Optional: Monitoring
# SENTRY_DSN=https://sentry-dsn
