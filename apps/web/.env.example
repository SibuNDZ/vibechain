# API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Solana Network (devnet or mainnet-beta)
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Custom Solana RPC URL (optional, defaults to public endpoint)
NEXT_PUBLIC_SOLANA_RPC_URL=

# Program Addresses (populated after deployment)
NEXT_PUBLIC_CROWDFUNDING_PROGRAM=
NEXT_PUBLIC_VOTING_PROGRAM=
